generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String      @id
  name              String
  brand             String
  category          String
  subtype           String?
  abv               Float
  volume            String
  unitsPerCase      Int
  casePrice         Int
  stockUnits        Int
  lowStockThreshold Int
  image             String
  description       String
  origin            String
  published         Boolean     @default(true)
  orderLines        OrderLine[]
}

model Order {
  id              String      @id @default(cuid())
  reference       String      @unique
  createdAt       DateTime    @default(now())
  status          String      @default("Pending")
  contactName     String
  email           String
  phone           String
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryDate    String?
  notes           String      @default("")
  internalNotes   String?
  invoiceStatus   String      @default("To invoice")
  paymentMethod   String      @default("card")
  companyName     String?
  tin             String?
  needsEbm        Boolean     @default(false)
  ebmPurchaseCode String?
  ebmInvoiceEmail String?
  confirmedAt     DateTime?
  packedAt        DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  subtotal        Int
  vat             Int         @default(0)
  deliveryFee     Int         @default(0)
  total           Int
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  lines           OrderLine[]
  payments        Payment[]
}

// Basic customer accounts (guest checkout remains the default path).
// customerId on Order is only set when the shopper was logged in at
// checkout; existing guest orders are never retroactively linked.
model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  isBusiness   Boolean  @default(false)
  companyName  String?
  tin          String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model OrderLine {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  name         String
  brand        String
  mode         String
  quantity     Int
  unitsPerCase Int
  casePrice    Int
  unitPrice    Int
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String   @unique
  status      String   @default("pending")
  amount      Int
  redirectUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Simple key-value store for settings that need to persist and change at
// runtime — currently just the admin portal password.
model Setting {
  key   String @id
  value String
}

// Staff accounts, separate from the single owner login (which still uses
// ADMIN_PASSWORD / the Setting table). role "admin" has full access
// (prices, inventory, settings, team); "staff" can view/process orders
// but not touch prices, stock, or team management.
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("staff")
  createdAt    DateTime @default(now())
}
