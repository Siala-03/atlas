generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String      @id
  name              String
  brand             String
  category          String
  subtype           String?
  abv               Float
  volume            String
  unitsPerCase      Int
  casePrice         Int
  stockUnits        Int
  lowStockThreshold Int
  image             String
  description       String
  origin            String
  orderLines        OrderLine[]
}

model Order {
  id              String      @id @default(cuid())
  reference       String      @unique
  createdAt       DateTime    @default(now())
  status          String      @default("Pending")
  contactName     String
  email           String
  phone           String
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryDate    String?
  notes           String      @default("")
  internalNotes   String?
  invoiceStatus   String      @default("To invoice")
  paymentMethod   String      @default("card")
  companyName     String?
  tin             String?
  needsEbm        Boolean     @default(false)
  ebmPurchaseCode String?
  ebmInvoiceEmail String?
  confirmedAt     DateTime?
  packedAt        DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  subtotal        Int
  vat             Int
  total           Int
  lines           OrderLine[]
  payments        Payment[]
}

model OrderLine {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  name         String
  brand        String
  mode         String
  quantity     Int
  unitsPerCase Int
  casePrice    Int
  unitPrice    Int
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String   @unique
  status      String   @default("pending")
  amount      Int
  redirectUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Simple key-value store for settings that need to persist and change at
// runtime — currently just the admin portal password.
model Setting {
  key   String @id
  value String
}
